# Base de datos\n# La URL de la base de datos debe ser solo del servidor; nunca uses NEXT_PUBLIC_DATABASE_URL.\nDATABASE_URL="postgresql://usuario:password@localhost:5432/tu_db"\nNEXT_PUBLIC_SITE_URL=http://localhost:3001\n# Lista de orígenes web adicionales autorizados para CORS, separados por coma; sin comodines.\n# El desarrollo local ya tiene localhost permitido. En producción, poné solo dominios reales adicionales.\n# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com,https://mobile.ejemplo.com\n\n# Moneda fija de catálogo: precios base almacenados en ARS (sin IVA).\n# La tienda suma el impuesto aplicable al mostrar y cobrar cada pedido.\n# Los visitantes fuera de Argentina ven una conversión estimada a USD.\nNEXT_PUBLIC_STORE_BASE_CURRENCY=ARS\n\n# Autenticación (NextAuth)\nNEXTAUTH_URL=http://localhost:3001\n# Generá un secreto único con: openssl rand -base64 32. No uses este marcador en producción.\nNEXTAUTH_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS\n\n# Autenticación Social (OAuth)\nGOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com\nGOOGLE_CLIENT_SECRET=tu_google_client_secret\nFACEBOOK_CLIENT_ID=tu_facebook_app_id\nFACEBOOK_CLIENT_SECRET=tu_facebook_app_secret\n\n# Comisión de la plataforma\nDEVELOPER_COMMISSION_PERCENT=8\n\n# ============================================================\n# TU CUENTA / DEVELOPER (mismas variables en todos los ecommerce)\n# ============================================================\n\n# Mercado Pago - aplicación developer\n# La integración actual opera en sandbox. La modalidad production queda bloqueada\n# hasta implementar y validar OAuth live del marketplace y el split de comisión.\nMERCADOPAGO_ENVIRONMENT=sandbox\nDEVELOPER_MERCADOPAGO_CLIENT_ID=tu_client_id_de_plataforma\nDEVELOPER_MERCADOPAGO_CLIENT_SECRET=tu_client_secret_de_plataforma\nDEVELOPER_MERCADOPAGO_SANDBOX_ACCESS_TOKEN=\nNEXT_PUBLIC_DEVELOPER_MERCADOPAGO_PUBLIC_KEY=TEST-tu_public_key_de_plataforma\n\n# Stripe Connect - cuenta developer (sandbox únicamente; live queda bloqueado hasta validar Connect real)\nSTRIPE_ENVIRONMENT=sandbox\nDEVELOPER_STRIPE_SECRET_KEY=sk_test_tu_secret_key_de_plataforma\nNEXT_PUBLIC_DEVELOPER_STRIPE_PUBLISHABLE_KEY=pk_test_tu_publishable_key_de_plataforma\n\n# PayPal Partner / developer (sandbox únicamente; live queda bloqueado hasta implementar y validar Partner live)\nDEVELOPER_PAYPAL_CLIENT_ID=tu_client_id_de_plataforma\nDEVELOPER_PAYPAL_CLIENT_SECRET=tu_client_secret_de_plataforma\nDEVELOPER_PAYPAL_MERCHANT_ID=tu_merchant_id_sandbox_de_plataforma\nDEVELOPER_PAYPAL_PARTNER_ATTRIBUTION_ID=tu_bn_code_de_partner\n\n# ============================================================\n# VINCULACIÓN DEL COMERCIO / CLIENTE\n# ============================================================\n# La credencial OAuth del comercio se guarda automáticamente, cifrada, en StorePaymentConnection.\n# Opcional: credenciales EXCLUSIVAS de prueba si se usa el checkout de tarjeta standalone.\n# No reutilices aquí una credencial de modo desconocido; la app no permite cobros live.\nSTORE_MERCADOPAGO_SANDBOX_ACCESS_TOKEN=\nNEXT_PUBLIC_STORE_MERCADOPAGO_SANDBOX_PUBLIC_KEY=\n# Obligatoria en cada entorno que reciba webhooks; configurar también de forma privada en Vercel.\nMERCADOPAGO_WEBHOOK_SECRET=\nSTORE_STRIPE_CONNECTED_ACCOUNT_ID=\nSTORE_PAYPAL_MERCHANT_ID=\n\n# Los tres proveedores permanecen en sandbox durante el desarrollo.\nPAYPAL_ENVIRONMENT=sandbox\nNEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox\n\n# Analytics (PostHog - Opcional)\n# NEXT_PUBLIC_POSTHOG_KEY=phc_tu_key_aqui\n# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com\n\n# Base de datos / Cloud (Aiven)\nAIVEN_API_TOKEN="tu_aiven_api_token"\nAIVEN_PROJECT_NAME="nombre_de_tu_proyecto_aiven"\nAIVEN_SERVICE_NAME="nombre_de_tu_servicio_aiven"\n\n# Configuración Móvil (Expo)\nEXPO_PUBLIC_API_URL=http://localhost:3001/api\n# Identidad legal del comercio (completar con datos reales antes de vender al público)\nSTORE_PUBLIC_NAME="Nombre comercial"\nSTORE_LEGAL_NAME="Razón social o nombre legal real"\nSTORE_LEGAL_TAX_ID="CUIT real del vendedor"\nSTORE_LEGAL_ADDRESS="Domicilio físico real del vendedor"\nSTORE_LEGAL_EMAIL=contacto@tu-dominio.com\nSTORE_LEGAL_PHONE="Teléfono de atención real"\nSTORE_LEGAL_HOURS="Días y horarios reales de atención"\n\n# Emails salientes (Brevo; el remitente debe estar registrado/verificado)\nBREVO_API_KEY=tu_api_key_de_brevo\n# Debe ser un remitente registrado/verificado en Brevo; para entregabilidad fiable, autentica el dominio.\nBREVO_FROM_EMAIL=pedidos@tu-dominio.com\nBREVO_FROM_NAME="Nombre comercial"\nCONTACT_RECIPIENT_EMAIL=tu_email@ejemplo.com\n\n# Resend: mantener para funciones de recepcion/inbound si estan configuradas.\n# No se utiliza Resend para enviar correos transaccionales desde la tienda.\nRESEND_API_KEY=re_tu_api_key\n\n# Operaciones programadas (Cloudflare Worker llama /api/cron/order-alerts cada 5 minutos)\n# Generá un secreto aleatorio de al menos 32 caracteres y usá el mismo valor en Vercel y Cloudflare.\nCRON_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_caracteres\n\n# Envíos\nSHIPPING_MODE=sandbox # "sandbox" o "production"\nSHIPPING_ORIGIN_NAME="Tu Ecommerce"\nSHIPPING_ORIGIN_EMAIL=envios@tu-dominio.com\nSHIPPING_ORIGIN_PHONE=+541100000000\nSHIPPING_ORIGIN_STREET="Av. Corrientes"\nSHIPPING_ORIGIN_NUMBER=1000\nSHIPPING_ORIGIN_FLOOR=\nSHIPPING_ORIGIN_APARTMENT=\nSHIPPING_ORIGIN_CITY="Ciudad de Buenos Aires"\nSHIPPING_ORIGIN_STATE="Ciudad de Buenos Aires"\nSHIPPING_ORIGIN_STATE_CODE=C\nSHIPPING_ORIGIN_POSTAL_CODE=1043\nSHIPPING_ORIGIN_COUNTRY=AR\n\n# Paquete por defecto (fallback cuando un SKU no tiene medidas propias)\nDEFAULT_PACKAGE_WEIGHT_KG=0.5\nDEFAULT_PACKAGE_LENGTH_CM=20\nDEFAULT_PACKAGE_WIDTH_CM=15\nDEFAULT_PACKAGE_HEIGHT_CM=5\n\n# Argentina: Zipnova (ex Zippin). En sandbox usá únicamente una cuenta demo/sandbox.\nZIPNOVA_API_TOKEN=tu_token\nZIPNOVA_API_SECRET=tu_secret\nZIPNOVA_ACCOUNT_ID=1\nZIPNOVA_ORIGIN_ID=1\nZIPNOVA_SANDBOX_ACCOUNT=true\n\n# Internacional: Shippo. En sandbox el token debe comenzar con shippo_test_.\nSHIPPO_API_TOKEN=shippo_test_tu_token\n\n# Opciones locales\nENABLE_STORE_PICKUP=true\nSTORE_PICKUP_ADDRESS="Av. Corrientes 1000, CABA"\nLOCAL_FLAT_RATE_ENABLED=true\nLOCAL_FLAT_RATE_PRICE=3500\n