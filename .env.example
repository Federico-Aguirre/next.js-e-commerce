# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/tu_db"
NEXT_PUBLIC_DATABASE_URL="postgresql://usuario:password@localhost:5432/tu_db"
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Moneda fija de catálogo: precios base almacenados en ARS (sin IVA).
# La tienda suma el impuesto aplicable al mostrar y cobrar cada pedido.
# Los visitantes fuera de Argentina ven una conversión estimada a USD.
NEXT_PUBLIC_STORE_BASE_CURRENCY=ARS

# Autenticación (NextAuth)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=clave_secreta_para_encriptar_cookies

# Autenticación Social (OAuth)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
FACEBOOK_CLIENT_ID=tu_facebook_app_id
FACEBOOK_CLIENT_SECRET=tu_facebook_app_secret

# Comisión de la plataforma
DEVELOPER_COMMISSION_PERCENT=10

# ============================================================
# TU CUENTA / DEVELOPER (mismas variables en todos los ecommerce)
# ============================================================

# Mercado Pago - aplicación developer
DEVELOPER_MERCADOPAGO_CLIENT_ID=tu_client_id_de_plataforma
DEVELOPER_MERCADOPAGO_CLIENT_SECRET=tu_client_secret_de_plataforma
NEXT_PUBLIC_DEVELOPER_MERCADOPAGO_PUBLIC_KEY=TEST-tu_public_key_de_plataforma

# Stripe Connect - cuenta developer
DEVELOPER_STRIPE_SECRET_KEY=sk_test_tu_secret_key_de_plataforma
NEXT_PUBLIC_DEVELOPER_STRIPE_PUBLISHABLE_KEY=pk_test_tu_publishable_key_de_plataforma

# PayPal Partner / developer
DEVELOPER_PAYPAL_CLIENT_ID=tu_client_id_de_plataforma
DEVELOPER_PAYPAL_CLIENT_SECRET=tu_client_secret_de_plataforma
DEVELOPER_PAYPAL_MERCHANT_ID=tu_merchant_id_sandbox_de_plataforma
DEVELOPER_PAYPAL_PARTNER_ATTRIBUTION_ID=tu_bn_code_de_partner

# ============================================================
# VINCULACIÓN DEL COMERCIO / CLIENTE
# ============================================================
# Normalmente estos valores se guardan automáticamente en StorePaymentConnection
# durante el onboarding. Sólo sirven como fallback MANUAL DE SANDBOX para una
# vinculación que igualmente aplica el split; nunca habilitan cobro directo.
STORE_MERCADOPAGO_OAUTH_ACCESS_TOKEN=
STORE_STRIPE_CONNECTED_ACCOUNT_ID=
STORE_PAYPAL_MERCHANT_ID=

# Los tres proveedores permanecen en sandbox durante el desarrollo.
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Analytics (PostHog - Opcional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_tu_key_aqui
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Base de datos / Cloud (Aiven)
AIVEN_API_TOKEN="tu_aiven_api_token"
AIVEN_PROJECT_NAME="nombre_de_tu_proyecto_aiven"
AIVEN_SERVICE_NAME="nombre_de_tu_servicio_aiven"

# Configuración Móvil (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001/api
# Identidad legal del comercio (completar con datos reales antes de vender al público)
STORE_PUBLIC_NAME="Nombre comercial"
STORE_LEGAL_NAME="Razón social o nombre legal real"
STORE_LEGAL_TAX_ID="CUIT real del vendedor"
STORE_LEGAL_ADDRESS="Domicilio físico real del vendedor"
STORE_LEGAL_EMAIL=contacto@tu-dominio.com
STORE_LEGAL_PHONE="Teléfono de atención real"
STORE_LEGAL_HOURS="Días y horarios reales de atención"

# Emails salientes (Brevo; el remitente debe estar registrado/verificado)
BREVO_API_KEY=tu_api_key_de_brevo
# Debe ser un remitente registrado/verificado en Brevo; para entregabilidad fiable, autentica el dominio.
BREVO_FROM_EMAIL=pedidos@tu-dominio.com
BREVO_FROM_NAME="Nombre comercial"
CONTACT_RECIPIENT_EMAIL=tu_email@ejemplo.com

# Resend: mantener para funciones de recepcion/inbound si estan configuradas.
# No se utiliza Resend para enviar correos transaccionales desde la tienda.
RESEND_API_KEY=re_tu_api_key

# Envíos
SHIPPING_MODE=sandbox # "sandbox" o "production"
SHIPPING_ORIGIN_NAME="Tu Ecommerce"
SHIPPING_ORIGIN_EMAIL=envios@tu-dominio.com
SHIPPING_ORIGIN_PHONE=+541100000000
SHIPPING_ORIGIN_STREET="Av. Corrientes"
SHIPPING_ORIGIN_NUMBER=1000
SHIPPING_ORIGIN_FLOOR=
SHIPPING_ORIGIN_APARTMENT=
SHIPPING_ORIGIN_CITY="Ciudad de Buenos Aires"
SHIPPING_ORIGIN_STATE="Ciudad de Buenos Aires"
SHIPPING_ORIGIN_STATE_CODE=C
SHIPPING_ORIGIN_POSTAL_CODE=1043
SHIPPING_ORIGIN_COUNTRY=AR

# Paquete por defecto (fallback cuando un SKU no tiene medidas propias)
DEFAULT_PACKAGE_WEIGHT_KG=0.5
DEFAULT_PACKAGE_LENGTH_CM=20
DEFAULT_PACKAGE_WIDTH_CM=15
DEFAULT_PACKAGE_HEIGHT_CM=5

# Argentina: Zipnova (ex Zippin). En sandbox usá únicamente una cuenta demo/sandbox.
ZIPNOVA_API_TOKEN=tu_token
ZIPNOVA_API_SECRET=tu_secret
ZIPNOVA_ACCOUNT_ID=1
ZIPNOVA_ORIGIN_ID=1
ZIPNOVA_SANDBOX_ACCOUNT=true

# Internacional: Shippo. En sandbox el token debe comenzar con shippo_test_.
SHIPPO_API_TOKEN=shippo_test_tu_token

# Opciones locales
ENABLE_STORE_PICKUP=true
STORE_PICKUP_ADDRESS="Av. Corrientes 1000, CABA"
LOCAL_FLAT_RATE_ENABLED=true
LOCAL_FLAT_RATE_PRICE=3500
