datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String            @id @default(uuid())
  name               String?
  firstName          String?
  lastName           String?
  phone              String?
  dni                String?
  shippingStreet     String?
  shippingNumber     String?
  shippingApartment  String?
  shippingCity       String?
  shippingProvince   String?
  shippingPostalCode String?
  shippingCountry    String?           @default("Argentina")
  email              String?           @unique
  emailVerified      DateTime?
  image              String?
  password           String? // es opcional porque los de Google no tienen contraseña
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accounts           Account[]
  sessions           Session[]
  orders             Order[]
  paymentCustomers   PaymentCustomer[]
  deliveryAddresses  DeliveryAddress[]
  cartItems          CartItem[]
  productReviews     ProductReview[]
  isAdmin            Boolean           @default(false)
  isPlatformOwner    Boolean           @default(false)
}

model DeliveryAddress {
  id                 String   @id @default(cuid())
  userId             String
  label              String   @default("Casa")
  shippingStreet     String
  shippingNumber     String
  shippingApartment  String?
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String
  shippingCountry    String   @default("Argentina")
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault, createdAt])
}

model PaymentCustomer {
  id                 String               @id @default(cuid())
  userId             String
  provider           String
  accountScope       String
  externalCustomerId String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards              SavedPaymentMethod[]

  @@unique([userId, provider, accountScope])
  @@unique([provider, accountScope, externalCustomerId])
  @@index([userId, provider])
}

model SavedPaymentMethod {
  id                String          @id @default(cuid())
  paymentCustomerId String
  externalCardId    String
  paymentMethodId   String
  paymentType       String?
  paymentMethodName String?
  lastFourDigits    String?
  expirationMonth   Int?
  expirationYear    Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paymentCustomer   PaymentCustomer @relation(fields: [paymentCustomerId], references: [id], onDelete: Cascade)

  @@unique([paymentCustomerId, externalCardId])
  @@index([paymentCustomerId, createdAt])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int // Cambiado a Int (o String, según uses en tu BD para los productos)
  createdAt DateTime @default(now())

  // Esto crea una clave compuesta para que un usuario no pueda 
  // agregar el mismo producto dos veces a su lista
  @@unique([userId, productId])
}

// 🛒 NUEVO MODELO: Para guardar los carritos persistidos en Aiven
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int // Uso Int porque GraphQL expone los IDs como Int
  title     String
  price     Float
  quantity  Int
  image     String
  size      String // Esencial para diferenciar si agregaron talle 39 o 42
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size]) // 👈 CANDADO: Evita duplicados a nivel de base de datos
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          Int              @id
  name        String
  description String           @db.Text
  price       Float
  category    String
  isActive    Boolean          @default(true)
  variants    ProductVariant[]
  reviews     ProductReview[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id        String         @id @default(uuid())
  colorName String
  productId Int
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade) // 🌟 Corregido: [id]
  skus      ProductSku[]
  images    VariantImage[]
}

model VariantImage {
  id        String         @id @default(uuid())
  url       String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade) // 🌟 Corregido: [id]
}

model ProductSku {
  id                  String         @id @default(uuid())
  articleId           Int            @unique
  size                String
  stock               Int            @default(10)
  shippingWeightGrams Int?
  shippingLengthCm    Int?
  shippingWidthCm     Int?
  shippingHeightCm    Int?
  lowStockAlertSent   Boolean        @default(false)
  lowStockAlertedAt   DateTime?
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade) // 🌟 Corregido: [id]
}

model Order {
  id                    String                   @id @default(uuid())
  orderNumber           Int                      @unique @default(autoincrement())
  userId                String
  total                 Float // Final total including the saved tax snapshot, in currency
  subtotal              Float                    @default(0) // Order item subtotal before tax
  taxAmount             Float                    @default(0) // Saved tax total in order currency
  taxRate               Float? // Percentage rate saved at checkout; null when destination tax is jurisdictional/unknown
  taxCalculationMethod  String?
  taxCountry            String?
  taxName               String?
  currency              String                   @default("ARS")
  paymentCurrency       String                   @default("USD")
  paymentTotal          Float? // Exact amount sent to the payment provider
  paymentExchangeRate   Float? // Multiplier from store base currency to payment currency
  platformCommissionPercent Float? // Effective platform commission snapshot applied to this payment
  platformFeeAmount      Float? // Platform commission snapshot in store currency (ARS)
  platformRecoveryAmount Float    @default(0) // Portion of this payment allocated to customization-cost recovery
  platformRecoveryCycleStartedAt DateTime? // Recovery cycle to which this payment belongs
  status                String // Payment status: "PENDING", "PAID", "REFUND_PENDING", "REFUNDED", "EXPIRED"
  checkoutKey           String?                  @unique
  paymentProvider       String?
  paymentExternalId     String?
  refundExternalId      String?
  refundStatus          String?
  refundedAt            DateTime?
  cancelledAt           DateTime?
  deliveredAt           DateTime?
  fulfillmentStatus     String                   @default("PENDING")
  trackingCode          String?
  estimatedDeliveryAt   DateTime?
  lastDeliveryAlertAt   DateTime?
  shippingProvider      String?
  shippingMode          String?
  shippingExternalId    String?
  shippingCarrier       String?
  shippingService       String?
  shippingRate          Float?
  shippingCurrency      String?
  shippingAmount        Float                    @default(0) // Shipping amount charged to the buyer, in order currency
  shippingQuoteRate     Float? // Carrier quote selected at checkout, in the quote currency
  shippingQuoteCurrency String?
  shippingLabelUrl      String?
  shippingTrackingUrl   String?
  shippingStatus        String?
  shippingError         String?                  @db.Text
  deliveryFirstName     String?
  deliveryLastName      String?
  deliveryPhone         String?
  deliveryDni           String?
  deliveryStreet        String?
  deliveryNumber        String?
  deliveryApartment     String?
  deliveryCity          String?
  deliveryProvince      String?
  deliveryPostalCode    String?
  deliveryCountry       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  expiresAt             DateTime
  user                  User                     @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  emailNotifications    OrderEmailNotification[]
  productReviews        ProductReview[]
}

model OrderEmailNotification {
  id                String    @id @default(cuid())
  orderId           String
  type              String    @default("PURCHASE_CONFIRMATION")
  recipientEmail    String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  providerMessageId String?
  lastError         String?   @db.Text
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([status, updatedAt])
}

// 🛒 items comprados, es el historial
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title     String
  price     Float
  quantity  Int
  size      String
  image     String
}

model ConsumerRequest {
  id            String   @id @default(uuid())
  requestCode   String   @unique
  requestType   String   @default("WITHDRAWAL")
  orderNumber   Int?
  customerEmail String
  details       String?  @db.Text
  locale        String   @default("es")
  status        String   @default("RECEIVED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail, createdAt])
}

model OrderOrReservation {
  id        String   @id @default(uuid())
  userId    String
  productId Int
  size      String
  quantity  Int
  status    String // "PENDING_PAYMENT", "PAID", "EXPIRED"
  createdAt DateTime @default(now())
  expiresAt DateTime // 🌟 La clave: createdAt + 10 minutos
}

model AnalyticsVisit {
  id        String   @id @default(cuid())
  sessionId String   @unique
  device    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([device, createdAt])
}

model InventoryAlertSettings {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  threshold Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSubscription {
  id                          String                     @id @default("default")
  status                      String                     @default("ACTIVE")
  storefrontStatus            String                     @default("OPEN")
  storefrontClosedAt          DateTime?
  planType                    String                     @default("STANDARD")
  nextPaymentAt               DateTime?
  commissionPercent           Float                      @default(8)
  setupRecoveryTarget         Float                      @default(200000)
  setupRecoveryStartedAt      DateTime?
  customizationRecoveryActive Boolean                    @default(false)
  monthlyPriceARS             Float                      @default(75000)
  pendingProCheckoutSessionId String?
  pendingProCheckoutExpiresAt DateTime?
  pendingProPaymentId         String?
  pendingProPaymentProvider   String?
  pendingProPaymentExpiresAt  DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  proPayments                 StoreSubscriptionPayment[]
}

model StoreSubscriptionPayment {
  id                     String           @id @default(cuid())
  subscriptionId         String           @default("default")
  adminUserId            String
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId  String?          @unique
  paymentProvider        String           @default("STRIPE")
  externalPaymentId      String?
  providerTransactionId  String?
  paymentAttemptId       String?          @unique
  paymentMethodRef       String?
  amountARS              Int
  paymentAmount          Float            @default(75000)
  paymentCurrency        String           @default("ARS")
  exchangeRate           Float            @default(1)
  currency               String           @default("ARS")
  status                 String           @default("PAID")
  paidAt                 DateTime?
  paidThrough            DateTime
  createdAt              DateTime         @default(now())
  subscription           StoreSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([paymentProvider, externalPaymentId])
  @@unique([paymentProvider, providerTransactionId])
  @@index([adminUserId, createdAt])
  @@index([adminUserId, paymentProvider, createdAt])
  @@index([paidThrough])
}

model StorePaymentConnection {
  provider              String    @id
  externalAccountId     String?
  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  tokenExpiresAt        DateTime?
  status                String    @default("CONNECTED")
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ProductReview {
  id        String   @id @default(cuid())
  productId Int
  userId    String
  orderId   String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([orderId])
}
