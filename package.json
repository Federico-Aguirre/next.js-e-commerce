    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "mercadopago": "^3.6.1",
    "next": "16.3.6",
    "next-auth": "^4.24.14",
    "next-intl": "^4.14.7",
    "pg": "^8.22.0",
    "posthog-js": "^1.434.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
