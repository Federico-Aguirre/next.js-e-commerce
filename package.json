{
  "name": "nextjs-e-commerce",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev -H 0.0.0.0 -p 3001 --webpack",
    "dev:next": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev -H 0.0.0.0 -p 3001 --webpack",
    "build:next": "next build",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "clean": "rimraf .next out coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:types": "tsc --noEmit --pretty",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "prepare": "husky"
  },
  "dependencies": {
